{
  "Salt state": {
    "prefix": "state",
    "body": [
      "${1:state_id}:",
      "  ${2:module}.${3:function}:",
      "    - name: ${4:value}",
      "$0"
    ],
    "description": "Generic Salt state"
  },
  "pkg.installed": {
    "prefix": "pkg.installed",
    "body": [
      "${1:package_name}:",
      "  pkg.installed:",
      "    - name: ${2:${1:package_name}}",
      "$0"
    ],
    "description": "Ensure a package is installed"
  },
  "pkg.removed": {
    "prefix": "pkg.removed",
    "body": [
      "${1:package_name}:",
      "  pkg.removed:",
      "    - name: ${2:${1:package_name}}",
      "$0"
    ],
    "description": "Ensure a package is removed"
  },
  "service.running": {
    "prefix": "service.running",
    "body": [
      "${1:service_name}:",
      "  service.running:",
      "    - name: ${2:${1:service_name}}",
      "    - enable: ${3:True}",
      "$0"
    ],
    "description": "Ensure a service is running and enabled"
  },
  "service.dead": {
    "prefix": "service.dead",
    "body": [
      "${1:service_name}:",
      "  service.dead:",
      "    - name: ${2:${1:service_name}}",
      "    - enable: ${3:False}",
      "$0"
    ],
    "description": "Ensure a service is stopped"
  },
  "file.managed": {
    "prefix": "file.managed",
    "body": [
      "${1:/path/to/file}:",
      "  file.managed:",
      "    - source: salt://${2:path/to/file}",
      "    - user: ${3:root}",
      "    - group: ${4:root}",
      "    - mode: '${5:0644}'",
      "$0"
    ],
    "description": "Manage a file from the Salt fileserver"
  },
  "file.directory": {
    "prefix": "file.directory",
    "body": [
      "${1:/path/to/directory}:",
      "  file.directory:",
      "    - user: ${2:root}",
      "    - group: ${3:root}",
      "    - mode: '${4:0755}'",
      "    - makedirs: ${5:True}",
      "$0"
    ],
    "description": "Ensure a directory exists"
  },
  "file.absent": {
    "prefix": "file.absent",
    "body": [
      "${1:/path/to/file}:",
      "  file.absent:",
      "    - name: ${2:${1:/path/to/file}}",
      "$0"
    ],
    "description": "Ensure a file or directory is absent"
  },
  "cmd.run": {
    "prefix": "cmd.run",
    "body": [
      "${1:command_name}:",
      "  cmd.run:",
      "    - name: ${2:command}",
      "$0"
    ],
    "description": "Run a command when the state changes"
  },
  "user.present": {
    "prefix": "user.present",
    "body": [
      "${1:username}:",
      "  user.present:",
      "    - name: ${2:${1:username}}",
      "    - shell: ${3:/bin/bash}",
      "$0"
    ],
    "description": "Ensure a user account exists"
  },
  "group.present": {
    "prefix": "group.present",
    "body": [
      "${1:group_name}:",
      "  group.present:",
      "    - name: ${2:${1:group_name}}",
      "$0"
    ],
    "description": "Ensure a group exists"
  },
  "include": {
    "prefix": "include",
    "body": [
      "include:",
      "  - ${1:state.module}",
      "$0"
    ],
    "description": "Include another Salt state"
  },
  "require": {
    "prefix": "require",
    "body": [
      "require:",
      "  - ${1:module}: ${2:state_id}",
      "$0"
    ],
    "description": "Require another state"
  },
  "require_in": {
    "prefix": "require_in",
    "body": [
      "require_in:",
      "  - ${1:module}: ${2:state_id}",
      "$0"
    ],
    "description": "Add a require requisite to another state"
  },
  "watch": {
    "prefix": "watch",
    "body": [
      "watch:",
      "  - ${1:module}: ${2:state_id}",
      "$0"
    ],
    "description": "Watch another state for changes"
  },
  "watch_in": {
    "prefix": "watch_in",
    "body": [
      "watch_in:",
      "  - ${1:module}: ${2:state_id}",
      "$0"
    ],
    "description": "Add a watch requisite to another state"
  },
  "onchanges": {
    "prefix": "onchanges",
    "body": [
      "onchanges:",
      "  - ${1:module}: ${2:state_id}",
      "$0"
    ],
    "description": "Run only when another state changes"
  },
  "onlyif": {
    "prefix": "onlyif",
    "body": [
      "onlyif: ${1:command}",
      "$0"
    ],
    "description": "Run only if a command succeeds"
  },
  "unless": {
    "prefix": "unless",
    "body": [
      "unless: ${1:command}",
      "$0"
    ],
    "description": "Run unless a command succeeds"
  },
  "pillar.get": {
    "prefix": "pillar.get",
    "body": [
      "{{ salt['pillar.get']('${1:key}', ${2:default}) }}$0"
    ],
    "description": "Read a value from Salt pillar"
  },
  "grains.get": {
    "prefix": "grains.get",
    "body": [
      "{{ salt['grains.get']('${1:key}', ${2:default}) }}$0"
    ],
    "description": "Read a value from Salt grains"
  }
}
